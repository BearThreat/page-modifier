[Unit]
Description=Page Modifier loopback bridge
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/blackbear/Desktop/page-modifier
Environment=PAGE_MODIFIER_DATA_DIR=/home/blackbear/.local/share/page-modifier
ExecStart=/usr/bin/node /home/blackbear/Desktop/page-modifier/bridge/server.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
